{
  "name": "hominin-atlas",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive 3D atlas of human evolution: skeletons, skulls, fractures and paleopathology of Homo sapiens, Neanderthals, Denisovans, the Flores 'hobbits' and other hominins. Built for kids and clinicians.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
